	/***************************************
	******************************************
	********************************************
					GENERATION DE PDF			
	********************************************
	********************************************
	********************************************/
	
	
	
	
	
	if(isset($_POST['print'])){
		// On charge les informations relatives à l'établissement présente en BD
		$infoEts = $config->chargerInformations();
		$_SESSION['ministere'] = strtoupper(utf8_decode($infoEts['nom_ministere']));
		$_SESSION['pays'] = $infoEts['nom_pays'];
		$_SESSION['ets'] = $infoEts['nom_ets'];
		$_SESSION['devise'] = $infoEts['nom_devise'];
		$_SESSION['contact'] = '';
		$_SESSION['signataire'] = $infoEts['titre_signataire'];
		$_SESSION['arrondissement'] = $infoEts['arrondissement'];
		$_SESSION['as'] = $infoEts['annee_scolaire'];
		
		/*---------------------------------------------------------
		------------------------------------------------------------
		-----------------------------------------------------------
		On veut imprimer la liste des élèves
		-------------------------------------------------------------
		-----------------------------------------------------------*/
		if($_POST['to_print']=='listeEleve'){
			$object = $_POST['object'];
			$liste = $config->listeEleve($object,'non_supprime');
			$infoListe = $config->infoEleveClasse($object,'non_supprime');
			$_SESSION['liste'] = $liste;
			$_SESSION['infoListe'] = $infoListe;
			$_SESSION['print'] = 'listeEleve';
			// echo '<pre>';print_r($infoEts);
			header('Location:print_pdf.php');
		}
		/*---------------------------------------------------------
		------------------------------------------------------------
		-----------------------------------------------------------
		On veut imprimer les relevés de notes
		-------------------------------------------------------------
		-----------------------------------------------------------*/ 
		elseif($_POST['to_print']=='ReleveNote'){
			$object = $_POST['object'];
			$liste = $config->listeEleve($object,'non_supprime');
			$_SESSION['liste'] = $liste;
			$_SESSION['print'] = 'ReleveNote';
			// echo '<pre>';print_r($liste);
			header('Location:print_pdf.php');
		}
		/*---------------------------------------------------------
		------------------------------------------------------------
		-----------------------------------------------------------
		On veut visualiser les notes séquentielles
		-------------------------------------------------------------
		-----------------------------------------------------------*/ 
		// 
		elseif($_POST['to_print']=='VisualiserNoteSequentielle'){
			// On envoie les notes dans la table créée spécialement 
			// pour la circonstance 
			
			$object = $_POST['classe'];
			$periode = $_POST['periode'];
			$note->viewNoteSequentielle($periode, $object);
			// On tente d'extraire : les noms des colonnes, les valeurs des lignes
			$nomTable = "view_sequence_".$periode."_".$object;
			$sql = "SELECT * FROM ".$nomTable;
			$req = mysql_query($sql);
			$nbCol = mysql_num_fields($req) - 7;  // Nombre de colonnes
			for($a=7;$a<$nbCol+7;$a++){
				$nomCol[] = mysql_field_name($req,$a);
			}
			$nbLigne = mysql_num_rows($req);
			for($e=0;$e<$nbLigne;$e++){
				$ligne[] = mysql_fetch_assoc($req);
			}
			
			$_SESSION['print'] ='VisualiserNoteSequentielle';
			$_SESSION['classe'] = $object;
			$_SESSION['sequence'] = $periode;
			$_SESSION['nbCol'] = $nbCol;
			$_SESSION['nomCol'] = $nomCol;
			$_SESSION['nbLn'] = $nbLigne;
			$_SESSION['ligne'] = $ligne;
			// echo $nbLigne;
			// echo '<pre>';print_r($_SESSION['ligne']);
			header('Location:print_pdf_landscape.php');
		}
		
		/*********************************************
		En construction
		*****************************/
		elseif($_POST['to_print']=='VisualiserNoteTrimestre'){
			// On envoie les notes dans la table créée spécialement 
			// pour la circonstance 
			
			$object = $_POST['classe'];
			$periode = $_POST['periode'];
			$note->viewNoteTrimestrielle($periode, $object);
			// On tente d'extraire : les noms des colonnes, les valeurs des lignes
			$nomTable = "view_trimestre_".$periode."_".$object;
			$sql = "SELECT * FROM ".$nomTable;
			$req = mysql_query($sql);
			$nbCol = mysql_num_fields($req) - 7;  // Nombre de colonnes
			for($a=7;$a<$nbCol+7;$a++){
				$nomCol[] = mysql_field_name($req,$a);
			}
			$nbLigne = mysql_num_rows($req);
			for($e=0;$e<$nbLigne;$e++){
				$ligne[] = mysql_fetch_assoc($req);
			}
			
			$_SESSION['print'] ='VisualiserNoteTrimestre';
			$_SESSION['classe'] = $object;
			$_SESSION['trimestre'] = $periode;
			$_SESSION['nbCol'] = $nbCol;
			$_SESSION['nomCol'] = $nomCol;
			$_SESSION['nbLn'] = $nbLigne;
			// $_SESSION['ligne'] = $ligne;
			// echo $nbLigne;
			// echo '<pre>';print_r($_SESSION['ligne']);
			// header('Location:print_pdf_landscape.php');
		}
		
		
		
		/*---------------------------------------------------------
		------------------------------------------------------------
		-----------------------------------------------------------
		On veut visualiser la vue d'ensemble des effectifs
		-------------------------------------------------------------
		-----------------------------------------------------------*/
		
		
		elseif($_POST['to_print']=='VueEffectif'){
			// D'abord on sélectionne toutes les classes
			$lsClasse = $config->viewClasse('actif');
			for($i=0;$i<count($lsClasse);$i++){
				$code_classe[] = $lsClasse[$i]['code_classe'];
				$nom_classe[] = $lsClasse[$i]['nom_classe'];
			}
			// Ensuite on affiche les effectifs en fonction de ces classes
			for($j=0;$j<count($code_classe);$j++){
				$liste[$code_classe[$j]] = $config->infoEleveClasse($code_classe[$j],'non_supprime');
				$name_classe[] = $code_classe[$j];
			}
			
			// $liste = $config->infoEleveClasse($cls,'non_supprime');
			$_SESSION['liste'] = $liste;
			$_SESSION['nom_classe'] = $name_classe;
			$_SESSION['print'] = 'VueEffectif';
			// echo '<pre>';print_r($_SESSION['nom_classe']);
			header('Location:print_pdf.php');
		}
		elseif($_POST['to_print']=='BulletinSequentiel'){
			print_r($_POST);
			$_SESSION['print'] =$_POST['print'];
			$_SESSION['sequence'] = $_POST['periode'];
			$_SESSION['classe'] = $_POST['classe'];
			$_SESSION['nomClasse'] = $note->viewNomClasse($_POST['classe']);
			$eleve = $note->moySequenceClasse($_POST['periode'], 
												$_POST['classe']);
			$eleve2 = $note->moySequenceClasseMerite($_POST['periode'], 
												$_POST['classe']);
			$tableBulletin = $note->sequenceClasse($_POST['periode'],
												$_POST['classe']);
			$tableStat = $note->statSequence($_POST['periode'], 
												$_POST['classe']);
			$nbGroupe = $note->afficheGroupe($_POST['classe']);
			for($w=0;$w<count($nbGroupe);$w++){
				$nomGpe = $nbGroupe[$w]['groupe'];
				$matiereGroupe[$nomGpe] = $note->matiereGroupe($nbGroupe[$w]['groupe'],
														$_POST['classe']);
			}
			
			
			$_SESSION['eleve'] = $eleve;
			$_SESSION['eleve2'] = $eleve2;
			$_SESSION['bulletin'] = $tableBulletin;
			$_SESSION['stat'] = $tableStat;
			$_SESSION['matiereGroupe'] = $matiereGroupe;
			// echo '<pre>';print_r($tableStat);
			// echo '<pre>';print_r($matiereGroupe);
			// echo '<pre>';print_r($_SESSION['bulletin']);
			header('Location:print_pdf.php');
		}
	}